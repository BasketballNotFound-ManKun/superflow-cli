{
  "name": "@chenmk/superflow",
  "version": "0.5.8",
  "description": "SuperBridge Flow workflow CLI for Claude Code and Codex",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "superflow",
    "superbridge-flow",
    "openspec",
    "superpowers",
    "sdd",
    "tdd",
    "codex",
    "claude-code"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "superflow": "dist/app/cli.js",
    "superflow-mcp": "dist/mcp/server.js",
    "superflow-install": "installer/bin/superflow-installer.cjs"
  },
  "files": [
    "dist",
    "installer",
    "scripts",
    "assets",
    "README.md",
    "README.zh-CN.md",
    "INSTALL.en.md",
    "INSTALL.md"
  ],
  "scripts": {
    "check:design-principles": "node scripts/check-design-principles.mjs",
    "check:managed-design": "node scripts/check-managed-work-design.mjs",
    "prebuild": "npm run check:design-principles && npm run check:managed-design",
    "build": "node scripts/clean-dist.js && tsc && node scripts/ensure-bin-modes.js",
    "dev": "tsx watch src/cli/index.ts",
    "postinstall": "node scripts/postinstall.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run release:check && npm test && npm run build",
    "release:check": "node scripts/release-notes-check.js",
    "pretest": "npm run check:design-principles && npm run check:managed-design",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ test/",
    "format": "prettier --write src/ test/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.0",
    "cross-spawn": "^7.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  }
}
