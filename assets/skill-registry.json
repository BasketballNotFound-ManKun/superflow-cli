{
  "version": "1.0.0",
  "contracts": [
    {
      "name": "superflow",
      "owner": "pipeline",
      "triggers": [
        "Superflow user entry"
      ],
      "excludes": [
        "unrelated general questions"
      ],
      "outputs": [
        "state.yaml handoff"
      ],
      "neighbors": [
        "superflow-clarify",
        "superflow-contracts",
        "superflow-handoff",
        "superflow-build",
        "superflow-verify",
        "superflow-archive"
      ],
      "visibility": "public"
    },
    {
      "name": "superflow-build",
      "owner": "implement",
      "triggers": [
        "implement approved change"
      ],
      "excludes": [
        "test plan design or signal selection; inherit frozen project/Superflow contracts"
      ],
      "outputs": [
        "tasks.md progress"
      ],
      "neighbors": [],
      "visibility": "internal"
    },
    {
      "name": "superflow-archive",
      "owner": "archive",
      "triggers": [
        "archive completed change"
      ],
      "excludes": [],
      "outputs": [
        "archive result and SDD lifecycle closeout"
      ],
      "neighbors": [],
      "visibility": "internal"
    },
    {
      "name": "superflow-explore",
      "owner": "explore",
      "triggers": [
        "explore requirements"
      ],
      "excludes": [],
      "outputs": [
        "alignment.md"
      ],
      "neighbors": [
        "superflow-propose"
      ],
      "visibility": "internal"
    },
    {
      "name": "superflow-propose",
      "owner": "propose",
      "triggers": [
        "generate OpenSpec proposal"
      ],
      "excludes": [
        "Superflow document completion, Coding Ready approval, or implementation dispatch"
      ],
      "outputs": [
        "proposal.md specs design.md tasks.md"
      ],
      "neighbors": [
        "superflow-clarify",
        "superflow-contracts"
      ],
      "visibility": "internal"
    },
    {
      "name": "superflow-clarify",
      "owner": "clarify",
      "triggers": [
        "clarify requirements"
      ],
      "excludes": [],
      "outputs": [
        "source-code-audit.md feature-gates.md brainstorm-summary.md"
      ],
      "neighbors": [
        "superflow-propose",
        "superflow-contracts"
      ],
      "visibility": "internal"
    },
    {
      "name": "superflow-design",
      "owner": "design",
      "triggers": [
        "technical design"
      ],
      "excludes": [],
      "outputs": [
        "technical_design"
      ],
      "neighbors": [
        "superflow-contracts",
        "superflow-handoff"
      ],
      "visibility": "internal"
    },
    {
      "name": "superflow-contracts",
      "owner": "docs",
      "triggers": [
        "SDD contract documents"
      ],
      "excludes": [
        "runtime execution or implementation prompt generation"
      ],
      "outputs": [
        "api.md tests.md sdd-quality-gate.md"
      ],
      "neighbors": [
        "superflow-clarify",
        "superflow-design",
        "superflow-handoff"
      ],
      "visibility": "internal"
    },
    {
      "name": "superflow-hotfix",
      "owner": "pipeline",
      "triggers": [
        "urgent small fix"
      ],
      "excludes": [],
      "outputs": [
        "bug-fix-plan.md"
      ],
      "neighbors": [],
      "visibility": "internal"
    },
    {
      "name": "superflow-handoff",
      "owner": "implement",
      "triggers": [
        "generate implementation prompts"
      ],
      "excludes": [
        "test strategy redesign; inherit tests.md"
      ],
      "outputs": [
        "prompt/ test-report.md"
      ],
      "neighbors": [
        "superflow-design",
        "superflow-verify"
      ],
      "visibility": "internal"
    },
    {
      "name": "superflow-requirement-review",
      "owner": "review",
      "triggers": [
        "review requirements"
      ],
      "excludes": [],
      "outputs": [
        "requirement-review.md"
      ],
      "neighbors": [],
      "visibility": "internal"
    },
    {
      "name": "superflow-table-impact-analysis",
      "owner": "docs",
      "triggers": [
        "table impact analysis"
      ],
      "excludes": [],
      "outputs": [
        "impact analysis"
      ],
      "neighbors": [],
      "visibility": "internal"
    },
    {
      "name": "superflow-tweak",
      "owner": "pipeline",
      "triggers": [
        "small wording tweak"
      ],
      "excludes": [],
      "outputs": [
        "tweak result"
      ],
      "neighbors": [],
      "visibility": "internal"
    },
    {
      "name": "superflow-quick-dev",
      "owner": "quick",
      "triggers": [
        "small code task",
        "quick development"
      ],
      "excludes": [
        "public API or database change",
        "cross-module change",
        "application, database, or real-entry acceptance outside the approved Quick Spec"
      ],
      "outputs": [
        ".sdd/tasks/<date>-<slug>/spec.md",
        "quick evidence"
      ],
      "neighbors": [
        "superflow-clarify",
        "superflow-verify"
      ],
      "visibility": "internal"
    },
    {
      "name": "superflow-verify",
      "owner": "verify",
      "triggers": [
        "verify implementation",
        "review code changes"
      ],
      "excludes": [
        "implementation or environment execution; assess evidence read-only",
        "requirement or test strategy redesign; inherit frozen contracts"
      ],
      "outputs": [
        "verification report"
      ],
      "neighbors": [
        "superflow-handoff",
        "superflow-archive"
      ],
      "visibility": "internal"
    },
    {
      "name": "superflow-api-changelog",
      "owner": "docs",
      "triggers": [
        "annotate API contract changes"
      ],
      "excludes": [
        "generate API contracts"
      ],
      "outputs": [
        "API change annotations"
      ],
      "neighbors": [
        "superflow-contracts"
      ],
      "visibility": "internal"
    }
  ]
}
